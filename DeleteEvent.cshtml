@model RaceDayMVC.Models.ViewModels.EventViewModel

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container mt-5">

    <h2>Delete Event</h2>

    <div class="alert alert-warning mt-3">
        Are you sure you want to delete this event?
        This action cannot be undone.
    </div>

    <div class="card shadow-sm p-4">

        <h4>@Model.Name</h4>

        <hr />

        <p><strong>Description:</strong> @Model.Description</p>

        <p><strong>Date:</strong> @Model.EventDate.ToString("dd MMMM yyyy")</p>

        <p><strong>Time:</strong> @Model.EventTime</p>

        <p><strong>Location:</strong> @Model.Location</p>

        <p><strong>Entry Fee:</strong> R @Model.EntryFee</p>

        <p><strong>Maximum Participants:</strong> @Model.MaxParticipants</p>

        <p><strong>Status:</strong> @Model.Status</p>

        <hr />

        <form asp-controller="Organiser"
              asp-action="ConfirmDeleteEvent"
              asp-route-id="@Model.EventID"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-danger">
                Yes, Delete Event
            </button>

            <a asp-controller="Organiser"
               asp-action="ManageEvents"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>