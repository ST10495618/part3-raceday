@model RaceDayMVC.Models.ViewModels.RecordResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<div class="container mt-5">

    <h2>Record Race Result</h2>
    <p>Enter the finishing details for a registered participant.</p>

    <hr />

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <form asp-controller="Organiser"
          asp-action="RecordResult"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="RegistrationID" class="form-label">
                Select Participant and Event
            </label>

            <select asp-for="RegistrationID" class="form-select">
                <option value="">-- Select Registration --</option>

                @foreach (var registration in Model.Registrations)
                {
                    <option value="@registration.RegistrationID">
                        Registration #@registration.RegistrationID
                        - @(registration.ParticipantDetails?.FirstName ?? "Unknown")
                        @(registration.ParticipantDetails?.LastName ?? "")
                        - @(registration.EventDetails?.Name ?? "Unknown Event")
                    </option>
                }
            </select>

            <span asp-validation-for="RegistrationID"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Position" class="form-label">
                Finishing Position
            </label>

            <input asp-for="Position"
                   type="number"
                   min="1"
                   class="form-control"
                   placeholder="e.g. 1" />

            <span asp-validation-for="Position"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="StartPosition" class="form-label">
                Starting Position
            </label>

            <input asp-for="StartPosition"
                   type="number"
                   min="1"
                   class="form-control"
                   placeholder="e.g. 5" />

            <span asp-validation-for="StartPosition"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="FinishTime" class="form-label">
                Finish Time
            </label>

            <input asp-for="FinishTime"
                   type="time"
                   step="1"
                   class="form-control" />

            <span asp-validation-for="FinishTime"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Pace" class="form-label">
                Pace
            </label>

            <input asp-for="Pace"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control"
                   placeholder="e.g. 5.25" />

            <span asp-validation-for="Pace"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">
                Result Status
            </label>

            <select asp-for="Status" class="form-select">
                <option value="Completed">Completed</option>
                <option value="Pending">Pending</option>
                <option value="Disqualified">Disqualified</option>
                <option value="Did Not Finish">Did Not Finish</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Result
        </button>

        <a asp-controller="Organiser"
           asp-action="ManageResults"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
