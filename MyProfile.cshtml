@model RaceDayMVC.Models.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-5">

    <h2>My Profile</h2>

    <p>Welcome, @ViewBag.FirstName!</p>

    <p>View your personal account information below.</p>

    <hr />

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow p-4 mt-3">

        <h4>Personal Information</h4>

        <hr />

        <p>
            <strong>User ID:</strong>
            @Model.UserID
        </p>

        <p>
            <strong>First Name:</strong>
            @Model.FirstName
        </p>

        <p>
            <strong>Last Name:</strong>
            @Model.LastName
        </p>

        <p>
            <strong>Email Address:</strong>
            @Model.Email
        </p>

        <p>
            <strong>Phone Number:</strong>
            @Model.Phone
        </p>

        <p>
            <strong>Account Status:</strong>

            @if (Model.IsActive)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-danger">Inactive</span>
            }
        </p>

        <p>
            <strong>Account Created:</strong>
            @Model.CreatedAt.ToString("dd MMMM yyyy")
        </p>

    </div>

    <div class="mt-3">

        <a asp-controller="Participant"
           asp-action="EditProfile"
           class="btn btn-primary">
            <i class="bi bi-pencil-square"></i> Edit Profile
        </a>

        <a asp-controller="Participant"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>

    </div>

</div>
